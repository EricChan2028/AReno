ter a year of working, his salary increased by 30%. How much are his total earnings after 3 years?\nSolution:", "solutions": ["259200"], "solution": "259200"}, "prompt_tokens": [151644, 872, 198, 50, 3948, 279, 2701, 11972, 34689, 6888, 3491, 13, 6928, 697, 32711, 323, 2182, 279, 1590, 4226, 304, 1124, 79075, 6257, 382, 31198, 25, 730, 2106, 702, 264, 400, 21, 15, 15, 15, 15088, 16107, 979, 566, 3855, 806, 2618, 13, 4636, 264, 1042, 315, 3238, 11, 806, 16107, 7172, 553, 220, 18, 15, 14360, 2585, 1753, 525, 806, 2790, 23681], "response_tokens": [151667, 198, 32313, 11, 773, 730, 2106, 8471, 448, 264, 15088, 16107, 315, 400, 21, 11, 15, 15, 15, 518, 4231, 220, 17, 15, 304, 806, 2618, 13, 4636, 264, 1042, 315, 3238, 11, 806, 16107, 12703, 553, 220, 18, 15, 14360, 5005, 11, 582, 1184, 311, 7071, 700, 806, 2790, 23681, 1283, 220, 18, 1635, 13, 6771, 752, 1438, 419, 1495, 3019, 553]}
